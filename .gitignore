.cache/

# ============================================
# Node.js / Frontend
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# Vite / Build output
**/dist/

# TypeScript
*.tsbuildinfo

# ============================================
# Wails (app/)
# ============================================
# Build outputs
app/bin/
app/build/bin/
app/build/darwin/
app/build/windows/
app/build/linux/
app/build/android/
app/build/ios/

# Wails generated bindings (optional, usually generated at build time)
# Uncomment if bindings are auto-generated and shouldn't be committed
# app/frontend/bindings/

# ============================================
# Backend (backend/)
# ============================================
# Compiled binary
backend/xhw-service
backend/xhw-service.exe

# Log files
*.log
backend/logs/

# Air hot reload temp
tmp/

# ============================================
# Environment & Config (Sensitive)
# ============================================
.env
.env.*
!.env.example

# Backend config files with real credentials
# NOTE: These contain secrets. If you need to track example configs,
# commit *.example.yaml instead and keep real configs local.
backend/config/config.yaml
backend/config/config.prod.yaml
backend/config/*.local.yaml

# App env files
app/frontend/.env.development
app/frontend/.env.production
app/frontend/.env.local

# ============================================
# General Build Output
# ============================================
/bin/
/build/
/dist/
/tmp/
tmp/
temp/
*.tmp
*.temp
*.pid
*.seed
*.pid.lock

